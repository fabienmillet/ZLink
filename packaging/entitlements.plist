<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.dev/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Qt WebEngine embarque un moteur JavaScript : sans ces deux droits, le
       runtime durci refuse la compilation à la volée et les vues web (chat,
       graphiques) restent noires. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- python-mpv charge libmpv par ctypes, et PyInstaller charge ses modules
       d'extension dynamiquement. La validation de bibliothèque refuserait ces
       chargements dans un processus durci. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- streamlink est lancé comme processus enfant et hérite du durcissement.
       Sans cela, l'exécutable fils est refusé au lancement. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
